{
  "expo": {
    "name": "help",
    "slug": "help",
    "scheme": "help",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F8FAFC",
    "ios": {
      "bundleIdentifier": "com.helpapp.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show professionals near you.",
        "NSPhotoLibraryUsageDescription": "Photos are used for your profile, portfolio and requests."
      }
    },
    "android": {
      "package": "com.helpapp.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#172B4D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show professionals near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos are used for your profile, portfolio and requests."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F766E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "46b23ab5-8f44-498e-9c86-4b58ac5ef710"
      }
    },
    "owner": "nikhil_daram"
  }
}
