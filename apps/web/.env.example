# Base URL of the API (including /api/v1)
VITE_API_URL=http://localhost:4000/api/v1
# Google Identity Services web client id
VITE_GOOGLE_CLIENT_ID=
# Razorpay public key id (test or live)
VITE_RAZORPAY_KEY_ID=
# Server-only: public origin used for canonical URLs / sitemap (defaults to request host)
SITE_URL=http://localhost:5173
PORT=5173
