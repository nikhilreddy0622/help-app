{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build && node scripts/vercel-finalize.mjs",
  "outputDirectory": "dist/client",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "regions": ["sin1"],
  "functions": {
    "api/render.js": { "includeFiles": "dist/server/**", "memory": 1024, "maxDuration": 15 }
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/render?__path=/$1" }]
}
