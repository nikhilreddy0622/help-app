# ---------- API (services/api/.env) ----------
NODE_ENV=development
PORT=4000
# Neon: use the POOLED url for DATABASE_URL and the direct url for DIRECT_URL (migrations)
DATABASE_URL=postgresql://help:help@localhost:5432/help
DIRECT_URL=postgresql://help:help@localhost:5432/help
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174   # used in admin password-reset links

# Auth
JWT_ACCESS_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-yyyyyyyyyyyyyyyy
GOOGLE_CLIENT_IDS=            # comma-separated: web, android, ios client ids
OTP_PROVIDER=console          # console | msg91 | firebase
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay (test keys in dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_DAYS=3

# Email (Nodemailer SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="help <no-reply@example.com>"

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push (Firebase service account JSON, base64-encoded)
FCM_SERVICE_ACCOUNT_B64=

# Geocoding
GOOGLE_MAPS_API_KEY=

# ---------- Web/Admin (apps/*/.env) ----------
VITE_API_URL=http://localhost:4000/api/v1
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=

# ---------- Mobile (apps/mobile/.env) ----------
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Seed (services/api: pnpm db:seed) ----------
# SUPER_ADMIN created by the seed. In non-production, falls back to admin@help.local / Admin@12345
# when unset (DEV ONLY - never relied on in production; set real values there).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true = also create ~30 demo providers around Bengaluru
SEED_DEMO=false
RUN_JOBS=true
